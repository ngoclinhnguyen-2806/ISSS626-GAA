### EHSA Classification and Visualization

```{r}
#| code-summary: Use built-in function emerging_hotspot_analysis() for classification
#| output: false
#| warning: false
#| error: false
#| message: false

ehsa_morning <- emerging_hotspot_analysis(
  x = st_morning,
  .var = "TOTAL_TRIPS",
  k = 1,
  nsim = 99
)

ehsa_afternoon <- emerging_hotspot_analysis(
  x = st_afternoon,
  .var = "TOTAL_TRIPS",
  k = 1,
  nsim = 99
)

ehsa_weekend <- emerging_hotspot_analysis(
  x = st_weekend,
  .var = "TOTAL_TRIPS",
  k = 1,
  nsim = 99
)
```

::: panel-tabset

#### Weekday Morning Peak

```{r}
#| code-summary: Plot distribution of hotspot classifications

ggplot(data = ehsa_morning, aes(x = classification)) +
  geom_bar(fill = "#FF6666") +
  coord_flip() +  # flip coordinates
  theme_light()
```

#### Weekday Afternoon Peak

```{r}
#| code-summary: Plot distribution of hotspot classifications

ggplot(data = ehsa_afternoon, aes(x = classification)) +
  geom_bar(fill = "#FF6666") +
  coord_flip() +  # flip coordinates
  theme_light()
```

#### Weekend/Holiday

```{r}
#| code-summary: Plot distribution of hotspot classifications

ggplot(data = ehsa_weekend, aes(x = classification)) +
  geom_bar(fill = "#FF6666") +
  coord_flip() +  # flip coordinates
  theme_light()
```
:::

### Combine Gi\* values with EHSA classification

::: panel-tabset

#### Weekday Morning Peak

```{r}
#| code-summary: Merge Gi* values with EHSA classifications

ehsa_morning_complete <- ehsa_morning %>%
  left_join(
    gi_stars_morning %>% 
      group_by(HEX_ID) %>%
      summarise(
        mean_gi_star = mean(gi_star, na.rm = TRUE),
        mean_p_gi = mean(p_sim, na.rm = TRUE)
      ),
    by = c("location" = "HEX_ID")
  ) %>%
  rename(HEX_ID = location)

head(ehsa_morning_complete)
```

```{r}
#| code-summary: Check complete results
#| echo: false
#| output: false

cat("Complete EHSA with Gi* values:\n", names(ehsa_morning_complete))
```

```{r}
#| code-summary: Filter significant hotspots for each (p < 0.05)
ehsa_sig_am <- ehsa_morning_complete %>% filter(p_value < 0.05)
ehsa_sig_am

```

