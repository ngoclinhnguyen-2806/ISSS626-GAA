```{r}
#| label: Extracting data of chosen business types
#| echo: false
#| eval: false
biz_selected <- acra_data %>%
  select(1:24) %>%
  filter(str_detect(primary_ssic_code, "^(561|471|681)")) %>%
  rename(date = registration_incorporation_date) %>%
  mutate(date = as.Date(date),
         YEAR = year(date),
         MONTH_NUM = month(date),
         MONTH_ABBR = month(date, 
                            label = TRUE, 
                            abbr = TRUE)) %>% 
  mutate(
    postal_code = str_pad(postal_code, 
    width = 6, side = "left", pad = "0")) %>%
  filter(YEAR >= 2024 & YEAR <= 2025) %>%  
  filter(date >= as.Date("2024-01-01") & date <= as.Date("2025-06-30")) 
```

